{
  "hosting": {
    "public": "apps/web/dist",
    "ignore": ["**/.*"],
    "rewrites": [
      {
        "source": "{/,/@(es|en|fr|de|it|pt|ca){,/**},/_site/**,/robots.txt,/sitemap.xml,/ads.txt,/.well-known/security.txt}",
        "run": {
          "serviceId": "site",
          "region": "europe-southwest1"
        }
      },
      {
        "source": "**",
        "destination": "/app.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
          }
        ]
      },
      {
        "source": "!{/,/@(es|en|fr|de|it|pt|ca){,/**},/_site/**,/robots.txt,/sitemap.xml,/ads.txt,/.well-known/security.txt}",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      },
      {
        "source": "/config.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "ui": {
      "enabled": false
    }
  }
}
