{
  "name": "thelever",
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "dev:realtime": "pnpm --filter @thelever-app/realtime dev",
    "dev:web": "pnpm --filter @thelever-app/web dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:acceptance": "pnpm --filter @thelever-app/tests test:acceptance",
    "emulators": "firebase emulators:start --only auth --project demo-thelever",
    "test:e2e": "pnpm --filter @thelever-app/web build && firebase emulators:exec --only auth --project demo-thelever 'pnpm --filter @thelever-app/tests test:e2e'"
  },
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@thelever-app/config": "workspace:*",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.33.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
